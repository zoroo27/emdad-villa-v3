    </path>
    <!-- 3D Recessed Door -->
    <path android:pathData="M20,39 L20,27 a4,4 0,0,1 8,0 L28,39 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="20" android:startY="25" android:endX="28" android:endY="39"
                android:startColor="#1E3563" android:endColor="#0B132B" />
        </aapt:attr>
