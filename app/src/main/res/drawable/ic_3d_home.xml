    <path android:fillColor="#55000000"
        android:pathData="M10,41 a14,3 0,1,0 28,0 a14,3 0,1,0 -28,0 z" />
    <!-- Left Sunlit Wall -->
    <path android:pathData="M11,22 L24,12 L24,39 L11,39 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="11" android:startY="12" android:endX="24" android:endY="39"
                android:startColor="#F8FAFC" android:endColor="#CBD5E1" />
        </aapt:attr>
    </path>
    <!-- Right Shaded Wall -->
    <path android:pathData="M24,12 L37,22 L37,39 L24,39 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="24" android:startY="12" android:endX="37" android:endY="39"
                android:startColor="#94A3B8" android:endColor="#64748B" />
        </aapt:attr>
    </path>
    <!-- 3D Gold Roof -->
    <path android:pathData="M24,6 L6,21 L10,25 L24,14 L38,25 L42,21 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="6" android:startY="6" android:endX="42" android:endY="25"
                android:startColor="#FFF3C4" android:centerColor="#D4AF37" android:endColor="#9A7214" />
